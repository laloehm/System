# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env) — SISTEMA DE AFILIADOS (GANGAS MX)
# Copia este archivo a '.env' y completa con tus claves personales.
# ==============================================================================

# ─── TELEGRAM ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui
TELEGRAM_CHAT_ID=tu_chat_id_personal_para_alertas_y_control
TELEGRAM_CHANNEL_ID=tu_canal_principal_de_ofertas
TELEGRAM_CHANNEL_BABY_ID=tu_canal_de_bebes_opcional
TELEGRAM_CHANNEL_PETS_ID=tu_canal_de_mascotas_opcional

# ─── INTELIGENCIA ARTIFICIAL ────────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_para_videos_tts

# ─── FACEBOOK ───────────────────────────────────────────────────────────────
# URLs de grupos separados por comas
FB_GROUP_URLS=https://www.facebook.com/groups/grupo1,https://www.facebook.com/groups/grupo2
FB_GROUPS_BABY_URLS=
FB_GROUPS_PETS_URLS=
FB_PAGE_ID=tu_id_de_pagina_de_facebook
FB_PAGE_TOKEN=tu_token_de_graph_api_para_la_pagina

# ─── AFILIADOS ──────────────────────────────────────────────────────────────
AMAZON_PARTNER_TAG=tu_tag_amazon-20
ML_AFFILIATE_ID=tu_id_afiliado_mercadolibre

# ─── APIFY (Llenado automático de colas) ────────────────────────────────────
APIFY_API_TOKEN=tu_apify_api_token
APIFY_KEYWORD_GENERAL=tecnologia
APIFY_KEYWORD_BABY=bebes
APIFY_KEYWORD_PETS=perros

# ─── INFRAESTRUCTURA Y SITIO WEB ───────────────────────────────────────────
GITHUB_TOKEN=tu_github_personal_access_token_para_landing_page
BLACKLIST_WORDS=funda,mica,case,protector,cable
MIN_PRICE=100.0
